{
  "endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user",
      "body": {
        "name": "string",
        "email": "string",
        "password": "string",
        "role": "admin | user"
      }
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Login user",
      "body": {
        "email": "string",
        "password": "string"
      }
    },
    {
      "method": "POST",
      "path": "/backup",
      "description": "Create backup (Admin only)",
      "headers": {
        "Authorization": "Bearer <token>"
      }
    },
    {
      "method": "POST",
      "path": "/restore",
      "description": "Restore backup (Admin only)",
      "headers": {
        "Authorization": "Bearer <token>"
      },
      "body": {
        "filePath": "string (backup folder path)"
      }
    }
  ]
}